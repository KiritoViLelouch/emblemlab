# API: export these variables in the API shell (not automatically loaded).
DATABASE_URL=sqlite:///./emblemlab.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend: place in apps/web/.env.local; evaluated at build time.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Statistics ingestion: both required for actual approved sources. Empty/default registry grants nothing.
# Keep the bearer token server-side; never expose it via NEXT_PUBLIC_* variables.
# STATISTICS_SOURCES_FILE=/absolute/path/to/operator-reviewed-sources.json
# STATISTICS_INGEST_TOKEN=<set-a-private-operator-token-in-the-shell>
